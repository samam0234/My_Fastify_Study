# 로컬 개발은 이 파일을 .env 로 복사한 뒤 값을 바꿉니다.
# 이미 셸에 같은 이름이 있으면 셸 값이 우선합니다.

NODE_ENV=development
APP_STAGE=final
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 16자 이상. 운영에서는 긴 무작위 문자열로 바꿉니다.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d

# 브라우저를 다른 출처에서 열 때. 같은 출처 정적 페이지는 이 값이 없어도 됩니다.
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_BASE_URL=http://127.0.0.1:3000

# sqlite | postgres | mariadb | mongodb
DB_CLIENT=sqlite
SQLITE_PATH=./data/board.db
# DATABASE_URL=postgres://study:study@127.0.0.1:5432/study
# DATABASE_URL=mysql://study:study@127.0.0.1:3306/study
# DATABASE_URL=mongodb://127.0.0.1:27017/fastify_study

UPLOAD_DIR=./data/uploads
OUTBOX_DIR=./data/outbox
CACHE_TTL_MS=5000
LOGIN_RATE_MAX=30

PAYMENT_WEBHOOK_SECRET=
SMTP_URL=
MAIL_FROM=study@example.com

# 비우면 발췌 기반 로컬 요약만 사용합니다. 있으면 OpenAI 호환 POST /v1/chat/completions 를 호출합니다.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=local-extractive

ENABLE_DEBUG_ROUTES=false
